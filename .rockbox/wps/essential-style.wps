# essential-style — While Playing Screen
# Author: Patrick Stigler
# Rev. 1 — 2026-09-08 — CC-BY-SA
#
# Inspired by Flattery-B (Christian Soffke),
# ipodVOL (xameius / Stephen Carroll),
# ChicagoUnified (Brendan Riera),
# Simple Icons / H120 (John Bayley / Stephen Carroll).
#
#
#	Load needed fonts
#
#	UI font (1) is 14-Nimbus from the theme cfg — titles, umlauts.
#	10-Nimbus for compact labels.
#
%Fl(2,10-Nimbus.fnt)
#
#	Preload icons
#
%xl(M,speakerMute.bmp,0,0)
%xl(L,speakerLoudest.bmp,0,0)
%xl(R,repeatMode.bmp,0,0,4)
%xl(S,shuffle.bmp,15,1)
%xl(bdv,volumeBarBackdrop.bmp,0,0)
%xl(bdps,progressBarShortBackdrop.bmp,0,0)
%xl(heart,heart.bmp,0,0)
%xl(broke,heartBroken.bmp,0,0)
%xl(D,diskActivity.bmp,0,0,8)
#
# ---------
# Logic:
# ---------
#
#
#
%?lh<%Vd(disk)>
%?mv(2)<%?or(%if(%pv, >, 0),%if(%St(volume display), =, numeric))<%Vd(vnum)>%Vd(m)%Vd(v)%Vd(l)|%Vd(shortprogress)%Vd(rating)>
#
#
# ---------
# Viewports:
# ---------
# 	Position in Playlist and number of items in total 
%V(4,22,120,10,2)%Vf(0)%Vb(3) 
%al%pp %Sx(of) %pe
#
#
# 	Repeat Mode and Shuffle indicators
#
%V(-30,23,24,9,2)%Vf(0)%Vb(3)
%?mm<|%xd(Ra)|%xd(Rb)|%xd(Rc)|%xd(Rd)>
%?if(%ps, =, s)<%xd(S)|>
#
#
# --------------------------------------
# --------   Volume Indicators   -------
# --------------------------------------
#
# 	Mute Speaker icon
#
%Vl(m,9,92,14,12,-)
%xd(M)
#
#
# 	Volume Bar 
#
%Vl(v,19,93,120,9,-)
%pv(0,0,120,9,volumeBar.bmp,backdrop,bdv)
#
#
# 	Loudest Speaker icon
#
%Vl(l,-19,92,14,12,-)
%xd(L)
#
#
# Numerical volume display
#
%Vl(vnum,0,114,160,10,2)%Vf(0)%Vb(3)
%ac%pv dB
#
#
# --------------------------------------
# -------- Progress Indicators   -------
# --------------------------------------
#
# 	Progress bar sits 8px higher than Flattery-B
# 	so the 16×16 ListenBrainz-style hearts have a clear row below.
# 	8px inset on both sides (elapsed time removed).
#
# 	Progress bar
%Vl(shortprogress,8,93,144,9,-)
%pb(0,0,144,9,progressBarShort.bmp,backdrop,bdps)
#
# Rating: 0 = · ; 1-4 = broken heart ; 5-10 = heart
# Hearts are 16×16 Font Awesome silhouettes (love / heart-crack).
#
%Vl(rating,72,107,16,16,2)%Vf(0)%Vb(3)
%ac%?rr<·|%xd(broke)|%xd(broke)|%xd(broke)|%xd(broke)|%xd(heart)|%xd(heart)|%xd(heart)|%xd(heart)|%xd(heart)|%xd(heart)>
#
# Disk activity spinner, flush to the bottom-left (9×9, y=119).
%Vl(disk,0,119,9,9,-)%Vf(0)%Vb(3)
%t(0.1)%xd(Da);%t(0.1)%xd(Db);%t(0.1)%xd(Dc);%t(0.1)%xd(Dd);%t(0.1)%xd(De);%t(0.1)%xd(Df);%t(0.1)%xd(Dg);%t(0.1)%xd(Dh)
#
#
# --------------------------------------
# -----------  Song Info   -------------
# ---------  WITHOUT COVER  ------------
# --------------------------------------
#
# Title, or filename if no title is available 
#
%V(0,40,160,14,1)
%s%ac%?it<%it|%fn>
#
#
# Composer if available (only for Classical music) & Artist 
#
%V(0,56,160,14,1)
%s%ac%?if(%ig,=,Classical)<%?ic<By %ic - >%ia|%ia>
#
# Album 
#
%V(0,72,160,14,1)
%s%ac%id
#